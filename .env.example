# Root environment example. Copy to .env for docker compose usage:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# Then set JWT_SECRET_KEY below and run: docker compose up --build -d
# NOTE: never commit real secrets. Each service also has its own .env.example.

# PostgreSQL (used by docker-compose postgres service).
# Compose builds DATABASE_URL automatically from these, no need to set DATABASE_URL here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=timetable

# Backend auth (REQUIRED for docker compose).
# Without this, backend injects a blank string and POST /api/v1/auth/login fails
# with 500 "JWT_SECRET_KEY is not configured".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-48-plus-char-secret

# Backend CORS (comma-separated). Frontend runs on port 3000.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (Vite). Points at the backend API.
VITE_API_URL=http://localhost:8000

# Reference only (local run without Docker, see backend/.env.example):
# Local PostgreSQL must exist with DB "timetable".
# DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:password@localhost:5432/timetable
# Docker equivalent (auto-built by compose, host is service name "postgres"):
# DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:password@postgres:5432/timetable
