# Root environment example. Copy to .env for docker compose usage.
# NOTE: never commit real secrets. Each service also has its own .env.example.

# PostgreSQL (used by docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=timetable

# Backend (local run without Docker)
# Local PostgreSQL must exist with DB "timetable".
DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:password@localhost:5432/timetable
# Backend (Docker run: host is the compose service name "postgres")
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:password@postgres:5432/timetable

# Backend CORS (comma-separated). Frontend runs on port 3000.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (Vite). Points at the backend API.
VITE_API_URL=http://localhost:8000
