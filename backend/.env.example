# Backend environment example. Copy to backend/.env for local runs.
# For Docker Compose, DATABASE_URL is injected by compose (host "postgres").
APP_NAME=Intelligent Timetable Generator
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Local run (PostgreSQL on localhost, DB "timetable" must exist)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/timetable
# Docker run equivalent:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres:5432/timetable

# Comma-separated allowed origins. Frontend runs on port 3000.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database used by pytest (must exist; tests truncate it, never use production data).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/timetable_test

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=<generate-a-secure-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Timetable solver (OR-Tools CP-SAT, local; override per request via options)
TIMETABLE_SOLVER_TIME_LIMIT_SECONDS=30
TIMETABLE_SOLVER_NUM_WORKERS=4
TIMETABLE_SOLVER_RANDOM_SEED=42
