# ─── Environment / secrets (never commit real values) ──────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
*.pem
*.key
*.crt

# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/

# ─── Node / Frontend ────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ─── IDE / OS ───────────────────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Logs / temporary files ─────────────────────────────────────────
*.log
logs/
tmp/
*.tmp
*.temp
coverage/

# ─── Local database artifacts (dumps/backups only) ──────────────────
*.sqlite
*.sqlite3
*.db
pgdata/
*.dump

# NOTE: backend/alembic/ and backend/alembic/versions/ are source code
# and MUST be committed. Only local dumps/backups are ignored above.
